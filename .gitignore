# Generated by Cargo
# will have compiled files and executables
debug
target

# Packaged macOS app bundle (build artifact from package_macos.sh)
/dist/

# Local Claude Code tooling state (settings, ct findings db)
.claude/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# ── Python (evolve.py / tree_optimizer.py tooling) ──
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── evolve.py autonomous-optimizer runtime artifacts ──
# State, logs, snapshots, renders, and generated docs the optimizer regenerates
# each run. The harness CODE (evolve.py, tree_optimizer.py) is tracked; everything
# it produces at runtime is not.
EVOLVE_CONTEXT.md
README_EVOLVE.md
OPTIMIZATION_NOTES.md
OPTIMIZER_STATUS.md
EVOLVE_STATUS.md
evolve_state.json
optimizer_state.json
optimizer_history.jsonl
evolve_log.txt
optimizer_log.txt
tree_optimizer_stdout.log
.evolve_session_*.log
.evolve_pause
/snapshots/
/renders/
